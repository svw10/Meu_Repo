# ===========================================
# ANTIGRAVITY OS / MODELOS - ENVIRONMENT VARIABLES
# ===========================================
# IMPORTANTE: Copie este arquivo para .env e preencha com valores reais somente os itens que fazem parte do projeto
# NUNCA commite o arquivo .env no Git!

# -------------------------------------------
# 1. CORE APPLICATION
# -------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:8080

# -------------------------------------------
# 2. DATABASE (Neon PostgreSQL + Prisma)
# -------------------------------------------
# DATABASE_URL: Usada pela aplicação (Pooler - Termina com pgbouncer=true)
DATABASE_URL="postgresql://neondb_owner:SUA_SENHA_AQUI@ep-super-shape-ac0k07tb-pooler.sa-east-1.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"

# DIRECT_URL: Usada APENAS pelo Prisma para rodar migrations (Non-pooling)
DIRECT_URL="postgresql://neondb_owner:SUA_SENHA_AQUI@ep-super-shape-ac0k07tb.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# -------------------------------------------
# 3. AUTHENTICATION (Clerk)
# -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# -------------------------------------------
# 4. QUEUES & BACKGROUND JOBS (Inngest)
# -------------------------------------------
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_DEV=1 # Set to "1" for local dev, "0" for prod

# -------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & LLMs
# -------------------------------------------
# OpenRouter (LLM Routing)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL_DEFAULT=google/gemini-flash-2.0
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-chat

# Fal.ai (Geração de Imagens ultra-rápida)
FAL_KEY=...

# Replicate (AI Models / Background Removal)
REPLICATE_API_TOKEN=r8_...

# RunPod (GPU Serverless para modelos pesados customizados)
RUNPOD_API_KEY=...
RUNPOD_RMBG_ENDPOINT=...
RUNPOD_VTON_ENDPOINT=...

# -------------------------------------------
# 6. SCRAPING & AUTOMATION (Apify)
# -------------------------------------------
APIFY_API_TOKEN=apify_api_...

# -------------------------------------------
# 7. STORAGE & MEDIA CDN
# -------------------------------------------
# Cloudinary (Otimização dinâmica de imagens)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Cloudflare R2 (Armazenamento em massa / S3 Compatible)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=snapfit-production
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXX.r2.dev

# -------------------------------------------
# 8. CACHE & RATE LIMITING (Upstash Redis)
# -------------------------------------------
REDIS_URL=redis://default:...@....upstash.io:6379
REDIS_TOKEN=...

# -------------------------------------------
# 9. COMMUNICATIONS (Email & WhatsApp)
# -------------------------------------------
# Resend (Emails Transacionais)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@snapfit.com.br
RESEND_FROM_NAME="SnapFit - Provador Virtual"

# Evolution API (WhatsApp Business)
EVOLUTION_API_URL=https://apievolution.suportevendaweb.com.br
EVOLUTION_API_KEY=...
EVOLUTION_INSTANCE_NAME=snapfit

# -------------------------------------------
# 10. PAYMENTS & SUBSCRIPTIONS
# -------------------------------------------
# Infinite Pay
INFINITPAY_API_KEY=...
INFINITPAY_CLIENT_ID=...

# Stripe (Fallback/Alternativa, já que está nos seus mocks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# -------------------------------------------
# 11. MONITORING, LOGGING & ANALYTICS
# -------------------------------------------
# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_AUTH_TOKEN=...

# Better Stack / Logtail (Central de Logs)
LOGTAIL_SOURCE_TOKEN=...

# -------------------------------------------
# 12. SECURITY & COMPLIANCE (LGPD)
# -------------------------------------------
# Chaves de Criptografia
JWT_SECRET=... # Min 32 chars
ENCRYPTION_KEY=... # Min 32 chars

# Retenção de Dados
RETENTION_INPUT_IMAGES_HOURS=2
RETENTION_OUTPUT_IMAGES_HOURS=24
RETENTION_CONVERSATION_LOGS_DAYS=90

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_DAY=5
RATE_LIMIT_MAX_REQUESTS_PER_HOUR=100

# -------------------------------------------
# 13. FEATURE FLAGS & DEV CONFIG
# -------------------------------------------
DEV_ENABLE_ALL_FEATURES=false
MOCK_RUNPOD=false
MOCK_EVOLUTION=false
MOCK_STRIPE=false

# -------------------------------------------
# 14. ADMIN & FINOPS (Controle de Custos)
# -------------------------------------------
ADMIN_EMAIL=luciano@aprenderia.com.br
TARGET_COGS_PER_GENERATION=0.25
ALERT_COGS_THRESHOLD=0.35

# -------------------------------------------
# 15. EXTERNAL WORKERS
# -------------------------------------------
QC_WORKER_URL=http://localhost:8001
QC_WORKER_API_KEY=...

# -------------------------------------------
# 16. EXTERNAL WORKERS
# -------------------------------------------
# ElevenLabs (Geração de Voz / TTS)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID_DEFAULT=...

# -------------------------------------------
# 17. EXTERNAL WORKERS
# -------------------------------------------
# Serper.dev (Google Search API para Agentes / RAG)
SERPER_API_KEY=...

# -------------------------------------------
# 18. EXTERNAL WORKERS
# -------------------------------------------
# Meta / WhatsApp Cloud API (Alternativa oficial à Evolution)
WHATSAPP_CLOUD_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=...

# -------------------------------------------
# 19. EXTERNAL WORKERS
# -------------------------------------------
# PostHog (Product Analytics e Session Recording)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=...

# -------------------------------------------
# 20. EXTERNAL WORKERS
# -------------------------------------------
# Tally.so (Formulários e Pesquisas)
TALLY_API_KEY=...
TALLY_WEBHOOK_SECRET=...

# -------------------------------------------
# 21. EXTERNAL WORKERS
# -------------------------------------------
# Airtable (Armazenamento rápido, CRM e CMS para Agentes)
# Nota: O Airtable agora exige Personal Access Tokens (PAT) em vez da antiga API Key.
AIRTABLE_API_KEY=pat_...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=... # Opcional: Nome ou ID da tabela principal